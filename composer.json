{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "taldres/laravel-immutable-attributes",
    "description": "Guard Eloquent model attributes against changes once a row exists: declare them with #[Immutable] and every save that would alter them throws.",
    "keywords": [
        "laravel",
        "eloquent",
        "immutable",
        "attributes",
        "model",
        "data-integrity"
    ],
    "homepage": "https://github.com/taldres/laravel-immutable-attributes",
    "license": "MIT",
    "authors": [
        {
            "name": "Dennis Petersmann"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Taldres\\ImmutableAttributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taldres\\ImmutableAttributes\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
